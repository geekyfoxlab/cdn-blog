---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---
{page.data.length > 0 ? (
	<>
		<h1 class="sr-only">文章列表</h1>
		<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
		{page.data.map((entry: CollectionEntry<"posts">) => (
			<PostCard
				entry={entry}
				title={entry.data.title}
				tags={entry.data.tags}
				category={entry.data.category}
				published={entry.data.published}
				updated={entry.data.updated}
				url={getPostUrlBySlug(entry.slug)}
				image={entry.data.image}
				description={entry.data.description}
				draft={entry.data.draft}
				class:list="onload-animation"
				style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
			></PostCard>
		))}
		</div>
	</>
) : (
	<section class="card-base flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center" data-pagefind-ignore>
		<Icon name="material-symbols:article-outline-rounded" class="mb-3 text-4xl text-[var(--primary)]" />
		<h1 class="mb-2 text-xl font-bold text-90">暂无公开文章</h1>
		<p class="text-50">文章正在整理中，欢迎稍后再来。</p>
	</section>
)}
