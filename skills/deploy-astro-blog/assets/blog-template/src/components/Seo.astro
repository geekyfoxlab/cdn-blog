---
import { getAbsoluteSiteAssetUrl, getCanonicalUrl } from "@utils/seo-utils";
import { profileConfig } from "@/config";
import { blogConfig } from "@/config/site";
import type { SeoProps } from "@/types/seo";

const {
	title,
	description,
	image,
	imageAlt,
	lang = blogConfig.language,
	type = "website",
	publishedTime,
	modifiedTime,
	tags = [],
	noindex = false,
}: SeoProps = Astro.props;

const normalizedTitle = title?.trim();
const pageTitle = normalizedTitle
	? `${normalizedTitle} | ${blogConfig.title}`
	: blogConfig.seo.defaultTitle;
const pageDescription =
	description?.trim() || blogConfig.seo.defaultDescription;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const socialImageUrl = getAbsoluteSiteAssetUrl(
	image || blogConfig.seo.defaultOgImage,
);
const locale = lang.replace("-", "_");
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={profileConfig.name} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

{!noindex && <link rel="canonical" href={canonicalUrl} />}
{blogConfig.rss.enabled && (
	<link
		rel="alternate"
		type="application/rss+xml"
		title={blogConfig.rss.title}
		href={new URL("rss.xml", `${blogConfig.siteUrl}/`).href}
	/>
)}

<meta property="og:site_name" content={blogConfig.title} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={locale} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && (
	<meta property="og:image:alt" content={imageAlt || pageTitle} />
)}

{type === "article" && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === "article" && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === "article" && tags.map((tag) => (
	<meta property="article:tag" content={tag} />
))}

<meta name="twitter:card" content={blogConfig.seo.twitterCard} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
{socialImageUrl && (
	<meta name="twitter:image:alt" content={imageAlt || pageTitle} />
)}
